root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,toml,scm}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[LICENSE-*]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
